# Which Stacks network to connect to: "mainnet" | "testnet" | "devnet"
VITE_STACKS_NETWORK=testnet

# The address that deployed contracts/import-export.clar, and the
# contract's name (defaults to the file name used by Clarinet.toml).
VITE_CONTRACT_ADDRESS=ST000000000000000000002AMW42H
VITE_CONTRACT_NAME=import-export

# Only needed when VITE_STACKS_NETWORK=devnet, to point at a local
# `clarinet devnet start` node instead of Hiro's public API.
VITE_DEVNET_API_URL=http://localhost:3999
